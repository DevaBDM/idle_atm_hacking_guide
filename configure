
INSTALL_FOLDER="guess_atm_in_idle_city_game_cache"
INSTALL_PREFIX="$PREFIX/opt/bin"
INSTALL="$INSTALL_PREFIX/$INSTALL_FOLDER"

bin_FILES="get-result.co send-to-bot.co start-new-game.co real-td.co"
if [ ! -d "$INSTALL" ];then
	mkdir -p "$INSTALL" || \
	exit 5 
fi

if [[ -s "hackIdleATM" && -s "finish_playing_hackIdleATM" ]];then
  mv "hackIdleATM" "finish_playing_hackIdleATM" "$INSTALL_PREFIX/" && \
  chmod +x "$INSTALL_PREFIX/hackIdleATM" "$INSTALL_PREFIX/finish_playing_hackIdleATM" || \
  echo "can't move hackIdleATM or finish_playing_hackIdleATM to \"$INSTALL_PREFIX/\"" \
  echo "move it yourself!!!!!" \
  exit 6
else
  echo "hackIdleATM or finish_playing_hackIdleATM not found"
  exit 7
fi

cmake -DCMAKE_BUILD_TYPE=release src/ && \ 
cmake --build . && \
termux-elf-cleaner $bin_FILES || \
exit 11
for file in $bin_FILES;do
	if [ -s "$file" ];then
		mv "$file" "$INSTALL/"
		chmod +x "$INSTALL/$file"
	else
		echo "\"$file\" not found"
		exit 8
	fi
done
echo "cd \"$INSTALL\"" > "$INSTALL_PREFIX/real-td" && \
echo "./real-td.co" >> "$INSTALL_PREFIX/real-td" && \
chmod +x "$INSTALL_PREFIX/real-td" || \
exit 9

cd $INSTALL_PREFIX
./real-td
